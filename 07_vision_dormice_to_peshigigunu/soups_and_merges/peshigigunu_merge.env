# merge.env (MR kit ops/m2rel): THE merge this kit stages. A different merge = a copy of this file with a new SPEC_ID, MEMBERS and
# M_<label>_* lines (and REF_* if someone read it), then the restage command in RUNBOOK.txt. Weights:
#     theta = BASE + sum_i COEF_i * tau_i     (fp32 on one GPU, one bf16 rounding per tensor; node/m2_build.py)
#   tau of a "full" member     = its weights - BASE (a complete fine-tune of BASE; every language-model and vision tensor)
#   tau of a "lowrank" member  = sum_j scale_j * B_j @ A_j  (our release-style update file + its JSON: peshashaga's format)
#   tau of a "peft" member     = (lora_alpha / r) * B @ A   (one of our trainer checkpoints: adapter.safetensors + state.json)
# Full members first, then low-rank / PEFT members, each in the order listed. One full member at COEF 1 = its tensors as they are.
# Sources: s3://... (our copies, preferred) or hf:<repo>@<revision> (token-less, pinned). HUB = the public origin named on the card.
SPEC_ID=m2
WORK=m2w
BASE=hf:Qwen/Qwen3.8-27B@1d4bf0f2ff6012fd82039f2fa52739d0dd7c60c0
MEMBERS="wemm peshashaga"
M_wemm_KIND=full
M_wemm_COEF=1.0
M_wemm_SRC=s3://YOUR_BUCKET/jev-race/models/wemm-decision_1543fbfc_sf
M_wemm_HUB=Rover00/WeMM-Decision@1543fbfcb171c7990607369e4c17329d3a7a6385
M_peshashaga_KIND=lowrank
M_peshashaga_COEF=0.5
M_peshashaga_SRC=s3://YOUR_BUCKET/jev-race/engineering/vision/s2b_release/bundle_s2bw
M_peshashaga_HUB=plantwaterer/peshashaga@61320dc8fb90b40af79f0366098d4fb034630838
# the d3 readout (the base LM head's rows of the 255 answer codes, as WeMM-Decision ships it) and its codes / temperature, unchanged
READOUT=hf:Rover00/WeMM-Decision@1543fbfcb171c7990607369e4c17329d3a7a6385
PROMPT=d3
D3_STATE=ocr
MIN_PIXELS=589824
MAX_PIXELS=1638400
# the reference read of this spec (parity target; WX's engine, H200, cached OCR) and the arithmetic to recompute it with
REF_READ=s3://YOUR_BUCKET/jev-race/engineering/vision/wx/reads/M2_ocr
REF_INDEX=83.533
REF_RECOMPUTE="wx 1.0 0.5"
# where the published run's ten benchmarks come from: rtx = 1 x RTX PRO 6000, all 11,410 rows in one process (as peshashaga; ~70 min);
# h200 = p8e's four H200 processes (fast restage, ~45 min end to end), with the RTX PRO 6000 latency on the 547-row sample only
PUBLISH=rtx
# outputs: S3 engineering/vision/<P_PREFIX>/ ; Winoground rows only under eval_restricted/winoground_research_only/reads/<WG_PREFIX>/
P_PREFIX=m2rel/runs/m2
WG_PREFIX=release_m2
